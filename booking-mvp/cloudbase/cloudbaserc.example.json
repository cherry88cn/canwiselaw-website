{
  "envId": "REPLACE_WITH_VERIFIED_FREE_ENV_ID",
  "functionRoot": "functions",
  "functions": [{
    "name": "canwise-booking",
    "runtime": "Nodejs20.19",
    "handler": "index.main",
    "timeout": 15,
    "memorySize": 128,
    "installDependency": true,
    "envVariables": {
      "ADMIN_UIDS": "REPLACE_WITH_OWNER_AUTH_UID",
      "RATE_SECRET": "SET_PRIVATELY_NOT_IN_REPOSITORY",
      "HTTP_PREFIX": "/booking",
      "ALLOWED_ORIGINS": "https://canwiselaw.com,https://www.canwiselaw.com"
    }
  }]
}
